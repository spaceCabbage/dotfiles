// Niri Configuration
// Gruvbox-themed Wayland compositor setup

// ========================================
// Environment Variables
// ========================================
environment {
    // NVIDIA Wayland requirements
    GBM_BACKEND "nvidia-drm"
    __GLX_VENDOR_LIBRARY_NAME "nvidia"
    LIBVA_DRIVER_NAME "nvidia"

    // General Wayland
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    QT_QPA_PLATFORM "wayland"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    MOZ_ENABLE_WAYLAND "1"

    // Electron apps
    ELECTRON_OZONE_PLATFORM_HINT "wayland"

    // GTK/Qt dark mode
    GTK_THEME "Adwaita:dark"
    ADW_DEBUG_COLOR_SCHEME "prefer-dark"
}

// ========================================
// Startup Programs
// ========================================
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "swww-daemon"
spawn-at-startup "swww" "img" "/home/yehuda/Pictures/sts-130.png"
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
spawn-at-startup "wlsunset" "-l" "32.0809" "-L" "34.7806"  // Tel Aviv
spawn-at-startup "xwayland-satellite"
spawn-at-startup "/usr/lib/xdg-desktop-portal-gtk"
spawn-at-startup "stasis"
spawn-at-startup "gsettings" "set" "org.gnome.desktop.interface" "color-scheme" "prefer-dark"

// ========================================
// Input Configuration
// ========================================
input {
    keyboard {
        xkb {
            layout "us,il"
            options "grp:alt_shift_toggle"
        }
        repeat-delay 300
        repeat-rate 50
    }

    touchpad {
        tap
        natural-scroll
        accel-speed 0.3
        accel-profile "adaptive"
        scroll-method "two-finger"
        dwt  // disable-while-typing
    }

    mouse {
        accel-speed 0.0
        accel-profile "flat"
    }

    // Trackpoint (ThinkPad)
    trackpoint {
        accel-speed 0.0
        accel-profile "flat"
    }
}

// ========================================
// Layout Configuration
// ========================================
layout {
    gaps 0

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#83a598"
        inactive-color "#504945"
    }

    border {
        off
    }

    struts {
        // Reserve space for waybar at top
        // top 32
    }
}

// ========================================
// Window Rules
// ========================================
window-rule {
    // Default for all windows
    geometry-corner-radius 6
    clip-to-geometry true
}

window-rule {
    match app-id="pavucontrol"
    open-floating true
    default-column-width { fixed 600; }
}

window-rule {
    match app-id="nm-connection-editor"
    open-floating true
}

window-rule {
    match app-id="blueman-manager"
    open-floating true
}

window-rule {
    match app-id="org.gnome.Calculator" app-id="gnome-calculator" app-id="kcalc"
    open-floating true
    default-column-width { fixed 400; }
}

window-rule {
    match app-id="xdg-desktop-portal-gtk"
    open-floating true
}

window-rule {
    match app-id="file-roller" app-id="org.gnome.FileRoller"
    open-floating true
}

window-rule {
    match title="^Open File$" title="^Save File$" title="^Open Folder$"
    open-floating true
}

window-rule {
    match app-id="steam"
    // Steam popups float
}

window-rule {
    match app-id="discord"
    default-column-width { proportion 0.6; }
}

window-rule {
    match app-id="brave-browser" app-id="firefox" app-id="chromium"
    default-column-width { proportion 0.6; }
}

window-rule {
    match app-id="org.kde.konsole" app-id="konsole"
    default-column-width { proportion 0.5; }
}

window-rule {
    match app-id="org.kde.dolphin" app-id="dolphin"
    default-column-width { proportion 0.5; }
}

// Scratchpad terminal
window-rule {
    match app-id="scratchpad"
    open-floating true
    default-floating-position x=0 y=0 relative-to="top"
}

// ========================================
// Cursor
// ========================================
cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

// ========================================
// Screenshots
// ========================================
screenshot-path "~/Pictures/Screenshots/screenshot_%Y-%m-%d_%H-%M-%S.png"

// ========================================
// Animations
// ========================================
animations {
    // Smooth animations
    slowdown 1.0

    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    window-open {
        duration-ms 200
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
    }
}

// ========================================
// Gestures (built-in)
// ========================================
// Niri has built-in touchpad gestures:
// - 3-finger horizontal swipe: switch workspaces
// - 3-finger vertical swipe up: overview
// These work automatically with touchpad enabled

// ========================================
// Hotkey Overlay
// ========================================
hotkey-overlay {
    skip-at-startup
}

// ========================================
// Keybindings
// ========================================
binds {
    // ---- Applications ----
    Mod+Return { spawn "konsole"; }
    Mod+B { spawn "brave"; }
    Mod+E { spawn "dolphin"; }
    Alt+Space { spawn "rofi" "-show" "drun"; }

    // Scratchpad dropdown terminal
    Mod+Shift+Return { spawn "konsole" "--name" "scratchpad"; }

    // ---- Window Management ----
    Mod+Q { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // ---- Navigation (Arrow Keys) ----
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }

    // ---- Move Windows ----
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }

    // ---- Mouse Scroll ----
    Mod+WheelScrollDown { focus-column-right; }
    Mod+WheelScrollUp { focus-column-left; }
    Mod+Shift+WheelScrollDown { move-column-right; }
    Mod+Shift+WheelScrollUp { move-column-left; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }

    // ---- Workspaces ----
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+Tab { focus-workspace-previous; }

    // ---- Column Width ----
    Mod+R { switch-preset-column-width; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // ---- Window Height ----
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // ---- Floating ----
    Mod+Space { toggle-window-floating; }

    // ---- Consume/Expel (Column Management) ----
    Mod+BracketLeft { consume-window-into-column; }
    Mod+BracketRight { expel-window-from-column; }

    // ---- Screenshots ----
    Mod+S { spawn "~/.local/bin/screenshot.sh" "area"; }
    Mod+Shift+S { spawn "~/.local/bin/screenshot.sh" "full"; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // ---- Utilities ----
    Mod+V { spawn "~/.local/bin/clipboard.sh"; }
    Mod+P { spawn "hyprpicker" "-a"; }
    Mod+L { spawn "swaylock"; }
    Mod+Shift+Q { spawn "~/.local/bin/powermenu.sh"; }

    // ---- Media Keys ----
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    // ---- Brightness Keys ----
    XF86MonBrightnessUp { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "5%-"; }

    // ---- Player Controls ----
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioPause { spawn "playerctl" "play-pause"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }

    // ---- Session ----
    Mod+Shift+E { quit; }
    Mod+Shift+R { spawn "niri" "msg" "action" "reload-config"; }

    // ---- Debug/Info ----
    Mod+Shift+D { toggle-debug-tint; }
}
