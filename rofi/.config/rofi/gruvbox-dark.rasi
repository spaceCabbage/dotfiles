/* Gruvbox Dark Theme for Rofi */

* {
    bg:             #282828c8;
    bg-alt:         #3c3836c1;
    fg:             #ebdbb2;
    fg-alt:         #928374;
    border:         #504945;
    accent:         #83a598;
    urgent:         #fb4934;

    background-color: transparent;
    text-color:       @fg;
    spacing:          0;
}

window {
    width:            600px;
    background-color: @bg;
    border:           1px;
    border-color:     @border;
    border-radius:    10px;
    padding:          16px;
}

mainbox {
    children: [ inputbar, message, listview, mode-switcher ];
    spacing: 16px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @bg-alt;
    border-radius:    8px;
    padding:          12px 16px;
}

prompt {
    text-color:       @accent;
    margin:           0 8px 0 0;
}

entry {
    placeholder:       "Inquire...";
    placeholder-color: @fg-alt;
}

message {
    background-color: @bg-alt;
    border-radius:    8px;
    padding:          8px 12px;
}

textbox {
    text-color: @fg;
}

listview {
    lines:            8;
    columns:          1;
    fixed-height:     true;
    scrollbar:        false;
    spacing:          4px;
}

element {
    padding:          12px 16px;
    border-radius:    8px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg;
}

element normal.urgent,
element alternate.urgent {
    text-color:       @urgent;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @bg;
}

element-icon {
    size:             24px;
    margin:           0 12px 0 0;
}

element-text {
    vertical-align:   0.5;
}

mode-switcher {
    spacing: 8px;
}

button {
    padding:          8px 16px;
    background-color: @bg-alt;
    text-color:       @fg-alt;
    border-radius:    8px;
}

button selected {
    background-color: @accent;
    text-color:       @bg;
}
