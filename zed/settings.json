{
  "terminal": {
    "font_size": 16.0,
    "font_family": "CaskaydiaCove Nerd Font",
    "font_fallbacks": ["monospace"],
    "cursor_shape": "bar"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": true
  },
  "base_keymap": "VSCode",
  "git_panel": {
    "fallback_branch_name": "master"
  },
  "project_panel": {
    "hide_root": true
  },
  "use_smartcase_search": true,
  "vertical_scroll_margin": 3.0,
  "gutter": {
    "line_numbers": true
  },
  "minimap": {
    "show": "never"
  },
  "cursor_blink": true,
  "autosave": "on_focus_change",
  "buffer_font_fallbacks": ["monospace"],
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "file_types": {
    "html": ["*.html"]
  },
  "linked_edits": true,
  "use_on_type_format": false,
  "tab_size": 2,
  "icon_theme": "Zed (Default)",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Gruvbox Dark"
  },
  "languages": {
    "Python": {
      "language_servers": [
        // Disable basedpyright and enable Ty
        "ty",
        "!basedpyright",
        "..."
      ]
    }
  }
}
