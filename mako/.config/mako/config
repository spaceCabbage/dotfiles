# Mako Notification Daemon Configuration
# Gruvbox Dark Theme

max-visible=5
sort=-time
layer=overlay
anchor=top-right

font=CaskaydiaCove Nerd Font 11
background-color=#282828
text-color=#ebdbb2
border-color=#504945
border-size=2
border-radius=12
padding=16
margin=12
width=350
height=150

icons=1
max-icon-size=48
icon-location=left

default-timeout=5000
ignore-timeout=0
group-by=app-name

on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss-all
on-touch=dismiss

[urgency=low]
border-color=#504945
default-timeout=3000

[urgency=normal]
border-color=#83a598
default-timeout=5000

[urgency=critical]
border-color=#fb4934
text-color=#fb4934
default-timeout=0
ignore-timeout=1

[app-name=Spotify]
border-color=#b8bb26

[app-name=discord]
border-color=#d3869b

[app-name=Brave]
border-color=#fe8019

[app-name=Firefox]
border-color=#fe8019
